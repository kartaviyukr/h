# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://neuromarket:neuromarket@db:5432/neuromarket

# Auth
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=

# DeepSeek (генерация меню)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=60

# RAG (рецепты)
RAG_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
RAG_TOP_K=5

# Сравнение цен (Фаза 5)
PRICE_CATALOG_PATH=data/price_catalog.json
PRICE_PROVIDERS=

# Later phases
SUPABASE_URL=
SUPABASE_ANON_KEY=
